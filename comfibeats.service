[Unit]
Description=Comfi Beats Discord Bot
After=network.target

[Service]
Type=simple
User=comfibeats
Group=comfibeats
WorkingDirectory=/opt/comfibeats
Environment="PATH=/home/comfibeats/.bun/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/comfibeats/.bun/bin/bun index.js
Restart=always
RestartSec=5
EnvironmentFile=/opt/comfibeats/.env

# Security Sandboxing
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/comfibeats/playlists /opt/comfibeats/audio /opt/comfibeats/guild_settings.json
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
